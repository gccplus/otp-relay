# 复制为 .env.production；不要提交真实值。
RELAY_DOMAIN=otp.example.com
PUBLIC_BASE_URL=https://otp.example.com/otp-relay
EXTERNAL_PROXY_NETWORK=reverse-proxy
POSTGRES_DB=otp_relay
POSTGRES_USER=otp_relay
# 使用仅含大小写字母和数字的随机长密码，避免 URL 转义问题。
POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
LOG_LEVEL=info
# Docker Hub 受限的服务器可改为可信镜像代理地址。
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NODE_IMAGE=node:22-alpine
